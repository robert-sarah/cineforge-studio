{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-release",
      "displayName": "CineForge Linux Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CINEFORGE_BUILD_GUI": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "CineForge Windows Release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CINEFORGE_BUILD_GUI": "ON"
      }
    },
    {
      "name": "windows-mingw-qt6",
      "displayName": "CineForge Windows MinGW Qt6",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/windows-mingw-qt6",
      "toolchainFile": "${sourceDir}/mingw-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "/opt/Qt/6.4.2/mingw_64",
        "QT_HOST_PATH": "/usr",
        "CMAKE_AUTOMOC_EXECUTABLE": "/usr/lib/qt6/libexec/moc",
        "CMAKE_AUTOUIC": "OFF",
        "CMAKE_AUTORCC": "OFF",
        "CINEFORGE_BUILD_GUI": "ON"
      }
    },
    {
      "name": "portable-cli",
      "displayName": "CineForge Portable CLI",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/portable-cli",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CINEFORGE_BUILD_GUI": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "portable-cli",
      "configurePreset": "portable-cli"
    },
    {
      "name": "windows-mingw-qt6",
      "configurePreset": "windows-mingw-qt6"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    }
  ]
}
